<?xml version="1.0" encoding="utf-8"?>
<!-- Seal IPTV for phones: merged over src/main/AndroidManifest.xml.
     The pages turn with the phone (upright or sideways); the player is always sideways.
     Not a TV app: no leanback launcher entry. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" tools:node="remove" />

    <application android:label="Seal IPTV" tools:replace="android:label">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize"
            tools:replace="android:screenOrientation,android:windowSoftInputMode">
            <intent-filter tools:node="removeAll" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            tools:replace="android:screenOrientation" />
    </application>
</manifest>
